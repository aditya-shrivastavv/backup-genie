<Window x:Class="BackupGenie.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Backup Genie"
        Width="1200"
        Height="780"
        MinWidth="980"
        MinHeight="620">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Padding="18"
            Margin="0,0,0,16"
            Background="#FFE7F1EC"
            CornerRadius="16">
      <StackPanel>
        <TextBlock FontSize="28" FontWeight="SemiBold" Foreground="#FF183E33" Text="Backup Genie" />
        <TextBlock Margin="0,6,0,0"
                   Foreground="#FF305C4E"
                   Text="Create lightweight, scheduled backups for the exact files and folders you choose." />
      </StackPanel>
    </Border>

    <GroupBox Grid.Row="1" Header="Backup Destination">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox Grid.Column="0"
                 Text="{Binding Settings.CentralBackupLocation, UpdateSourceTrigger=PropertyChanged}" />
        <Button Grid.Column="1" Content="Browse" Click="BrowseCentralLocation_Click" />
      </Grid>
    </GroupBox>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2.3*" />
        <ColumnDefinition Width="1*" />
      </Grid.ColumnDefinitions>

      <GroupBox Grid.Column="0" Header="Backup Jobs" Margin="0,0,16,16">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="Add Folder" Click="AddFolderJob_Click" />
            <Button Content="Add File" Click="AddFileJob_Click" />
            <Button Content="Remove Selected" Command="{Binding RemoveSelectedJobCommand}" />
            <Button Content="Run Selected Now" Command="{Binding RunSelectedNowCommand}" />
          </StackPanel>

          <DataGrid ItemsSource="{Binding Settings.BackupJobs}"
                    SelectedItem="{Binding SelectedJob}"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    HeadersVisibility="Column"
                    RowHeaderWidth="0"
                    GridLinesVisibility="Horizontal"
                    BorderThickness="0">
            <DataGrid.Columns>
              <DataGridCheckBoxColumn Header="On" Binding="{Binding IsEnabled}" Width="50" />
              <DataGridTextColumn Header="Name" Binding="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Width="180" />
              <DataGridTextColumn Header="Source Path" Binding="{Binding SourcePath}" Width="3*" IsReadOnly="True" />
              <DataGridTextColumn Header="Interval (min)" Binding="{Binding IntervalMinutes, UpdateSourceTrigger=PropertyChanged}" Width="110" />
              <DataGridTextColumn Header="Last Result" Binding="{Binding LastOutcome}" Width="130" IsReadOnly="True" />
              <DataGridTextColumn Header="Last Success" Binding="{Binding LastSuccessLocalTime}" Width="150" IsReadOnly="True" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </GroupBox>

      <StackPanel Grid.Column="1">
        <GroupBox Header="Background Behavior">
          <StackPanel>
            <CheckBox Margin="0,0,0,10"
                      Content="Keep running in background when I close the window"
                      IsChecked="{Binding Settings.RunInBackgroundOnClose}" />
            <CheckBox Margin="0,0,0,10"
                      Content="Start minimized to tray"
                      IsChecked="{Binding Settings.StartMinimized}" />
            <CheckBox Content="Launch automatically when I sign in"
                      IsChecked="{Binding Settings.LaunchAtSignIn}" />
          </StackPanel>
        </GroupBox>

        <GroupBox Header="Selected Job">
          <StackPanel>
            <TextBlock FontWeight="SemiBold" Text="{Binding SelectedJob.DisplayName}" />
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding SelectedJob.SourcePath}" />
            <TextBlock Margin="0,12,0,0" Text="{Binding SelectedJob.LastRunSummary}" TextWrapping="Wrap" />
          </StackPanel>
        </GroupBox>
      </StackPanel>
    </Grid>

    <DockPanel Grid.Row="3">
      <TextBlock VerticalAlignment="Center"
                 Foreground="#FF4D6158"
                 Text="{Binding StatusMessage}" />
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="Save Settings" Command="{Binding SaveCommand}" />
        <Button Content="Run All Now" Command="{Binding RunAllNowCommand}" />
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
